#!/usr/bin/env python3
import sys
import json
import requests
import os

# Configuration via environment variable (from opencode.json)
SEARX_URL = os.environ.get("SEARX_URL", "https://searxng.claw.graf.priv.at/search")

def search(query, category="general", time_range=None, engines=None, language=None, pageno=1, safesearch=None):
    params = {
        "q": query,
        "format": "json",
        "categories": category,
        "pageno": pageno
    }
    if time_range:
        params["time_range"] = time_range
    if engines:
        params["engines"] = engines
    if language:
        params["language"] = language
    if safesearch is not None:
        params["safesearch"] = safesearch

    try:
        response = requests.get(SEARX_URL, params=params, timeout=10)
        response.raise_for_status()
        data = response.json()

        results = []
        for r in data.get("results", [])[:20]:
            result = {
                "title": r.get("title"),
                "url": r.get("url"),
                "content": r.get("content")
            }
            if r.get("engine"):
                result["engine"] = r.get("engine")
            if r.get("publishedDate"):
                result["publishedDate"] = r.get("publishedDate")
            if r.get("img_src"):
                result["img_src"] = r.get("img_src")
            if r.get("thumbnail"):
                result["thumbnail"] = r.get("thumbnail")

            results.append(result)
        return results
    except Exception as e:
        return [{"title": "Connection Error", "url": "", "content": str(e)}]

def main():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            request = json.loads(line)
            method = request.get("method")
            req_id = request.get("id")

            if method == "initialize":
                response = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "protocolVersion": "2024-11-05",
                        "capabilities": {
                            "tools": {}
                        },
                        "serverInfo": {
                            "name": "opencode-searxng",
                            "version": "0.2.0"
                        }
                    }
                }
                print(json.dumps(response))
            elif method == "notifications/initialized":
                pass
            elif method == "tools/list":
                response = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "tools": [
                            {
                                "name": "searxng_search",
                                "description": "Performs a search via SearXNG. For very recent topics or 'latest' news, always specify a 'time_range'.",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {
                                        "query": {
                                            "type": "string",
                                            "description": "The search query. Use quotes for exact versions (e.g. \"Gemma 4\")."
                                        },
                                        "category": {
                                            "type": "string",
                                            "description": "The search category.",
                                            "enum": ["general", "images", "news", "it", "science"],
                                            "default": "general"
                                        },
                                        "time_range": {
                                            "type": "string",
                                            "description": "Filter results by age. Use 'month' or 'week' for brand new technologies to avoid outdated results.",
                                            "enum": ["day", "week", "month", "year"]
                                        },
                                        "engines": {
                                            "type": "string",
                                            "description": "Comma-separated list of specific engines to use (e.g. 'wikipedia,github,braveapi'). Overrides category selection."
                                        },
                                        "language": {
                                            "type": "string",
                                            "description": "Language code for results (e.g. 'en', 'de', 'fr', 'auto'). Filter results by language."
                                        },
                                        "pageno": {
                                            "type": "integer",
                                            "description": "Page number for paginated results (default: 1). Combine with time_range for older results.",
                                            "default": 1
                                        },
                                        "safesearch": {
                                            "type": "integer",
                                            "description": "Safe search filter: 0 (off), 1 (moderate), 2 (strict).",
                                            "enum": [0, 1, 2]
                                        }
                                    },
                                    "required": ["query"]
                                }
                            }
                        ]
                    }
                }
                print(json.dumps(response))
            elif method == "tools/call":
                args = request.get("params", {}).get("arguments", {})
                query = args.get("query")
                category = args.get("category", "general")
                time_range = args.get("time_range")
                engines = args.get("engines")
                language = args.get("language")
                pageno = args.get("pageno", 1)
                safesearch = args.get("safesearch")
                results = search(query, category, time_range, engines, language, pageno, safesearch)
                response = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "content": [{"type": "text", "text": json.dumps(results, indent=2)}]
                    }
                }
                print(json.dumps(response))
            sys.stdout.flush()
        except Exception:
            continue

if __name__ == "__main__":
    main()
