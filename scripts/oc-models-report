#!/usr/bin/env python3
"""Report capabilities/pricing of opencode models matching given substrings.

Optional --provider ID restricts the output to models of one provider
(exact, case-insensitive match against providerID; an unknown provider is an
error). Without --provider the substrings are matched against
provider/id/name/family and the rendered cost (so "free" finds 0/0 models).

Results are sorted by model id by default. --sort KEY orders them by a
capability/price column: model (aliases id, name), provider, in/input,
out/output, cost (aliases $, mtok, price = input+output), ctx/context, or
params (aliases param, size); all keys sort ascending, -r/--reverse flips
the active key. Ties keep the model id ascending as a stable secondary
order; unknown parameter counts always sort last.

Parameter counts (billions of parameters) come from a curated JSON file
(models + aliases) read from, in order: --params PATH, the
OC_MODELS_REPORT_PARAMS environment variable, or model-params.json next to
this script. The lookup key is the model id's last path segment, lowercased,
with a trailing ":free" stripped, then resolved through the aliases map. A
missing file is fine (all counts show "–"); a malformed file is a stderr
warning. --params-missing lists the keys that still lack an entry.

The model list is cached at ~/.local/share/oc-models-report/models-verbose.txt
($XDG_DATA_HOME respected) and regenerated via `opencode models --verbose`
whenever it is missing or older than 12 hours. Internal overrides (mainly for
tests): OC_MODELS_REPORT_CACHE_DIR, OC_MODELS_REPORT_MAX_AGE (seconds),
OC_MODELS_REPORT_CMD (command line to run instead of `opencode models
--verbose`).

Zero external dependencies (Python 3 stdlib only).
"""

import argparse
import functools
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

HDR = re.compile(r"^([A-Za-z0-9_.-]+/.+?)\s*$")

APP = "oc-models-report"
CACHE_FILE = "models-verbose.txt"
PARAMS_FILE = "model-params.json"
DEFAULT_MAX_AGE = 12 * 3600

SORT_ALIASES = {
    "model": "model",
    "id": "model",
    "name": "model",
    "provider": "provider",
    "in": "in",
    "input": "in",
    "out": "out",
    "output": "out",
    "cost": "cost",
    "$": "cost",
    "mtok": "cost",
    "price": "cost",
    "ctx": "ctx",
    "context": "ctx",
    "params": "params",
    "param": "params",
    "size": "params",
}


def cache_dir():
    override = os.environ.get("OC_MODELS_REPORT_CACHE_DIR")
    if override:
        return override
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "share"
    )
    return os.path.join(base, APP)


def max_age():
    try:
        return int(os.environ.get("OC_MODELS_REPORT_MAX_AGE", DEFAULT_MAX_AGE))
    except ValueError:
        return DEFAULT_MAX_AGE


def collect_cmd():
    override = os.environ.get("OC_MODELS_REPORT_CMD")
    if override:
        return shlex.split(override)
    return [shutil.which("opencode") or "opencode", "models", "--verbose"]


def default_params_path():
    """model-params.json next to the real script (survives the ~/bin symlink)."""
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), PARAMS_FILE)


def resolve_params_path(cli_path):
    if cli_path:
        return cli_path
    env = os.environ.get("OC_MODELS_REPORT_PARAMS")
    if env:
        return env
    return default_params_path()


def load_params(path):
    """Return (aliases, models) dicts, or None when absent/unreadable."""
    try:
        with open(path) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        print(f"warning: ignoring params file {path}: {exc}", file=sys.stderr)
        return None
    aliases = data.get("aliases", {}) if isinstance(data, dict) else {}
    models = data.get("models", {}) if isinstance(data, dict) else {}
    if not isinstance(aliases, dict) or not isinstance(models, dict):
        print(f"warning: ignoring malformed params file {path}", file=sys.stderr)
        return None
    return aliases, models


def params_key(qid):
    key = qid.rsplit("/", 1)[-1].lower()
    if key.endswith(":free"):
        key = key[:-len(":free")]
    return key


def lookup_params(params, qid):
    if not params:
        return None
    aliases, models = params
    key = params_key(qid)
    entry = models.get(key)
    if entry is None:
        canon = aliases.get(key)
        if canon is not None:
            entry = models.get(canon)
    return entry if isinstance(entry, dict) else None


def fmt_param_num(v):
    if v >= 1000:
        return ("%.1f" % (v / 1000)).rstrip("0").rstrip(".") + "T"
    if v >= 1:
        return ("%.1f" % v).rstrip("0").rstrip(".") + "B"
    return ("%.0f" % (v * 1000)) + "m"


def fmt_params(entry):
    if not entry or entry.get("total") is None:
        return "–"
    s = fmt_param_num(entry["total"])
    active = entry.get("active")
    if active is not None:
        s += "/" + fmt_param_num(active)
    return "~" + s if entry.get("estimated") else s


def needs_refresh(path, force, age_limit):
    if force or not os.path.isfile(path):
        return True
    return (time.time() - os.path.getmtime(path)) > age_limit


def collect(path, cmd):
    """Run the collect command and atomically store its stdout at path."""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    except FileNotFoundError:
        raise RuntimeError(f"command not found: {cmd[0]}")
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"command timed out: {' '.join(cmd)}")
    if proc.returncode != 0:
        detail = proc.stderr.strip().splitlines()
        raise RuntimeError(
            f"{' '.join(cmd)} failed (exit {proc.returncode})"
            + (f": {detail[-1]}" if detail else "")
        )
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(
        dir=os.path.dirname(path), prefix=".models-verbose.", suffix=".tmp"
    )
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(proc.stdout)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def ensure_dump(path, force, age_limit):
    """Return True when the dump was (re)generated in this run."""
    if not needs_refresh(path, force, age_limit):
        return False
    try:
        collect(path, collect_cmd())
    except RuntimeError as exc:
        if os.path.isfile(path):
            print(f"warning: {exc}; using cached dump", file=sys.stderr)
            return False
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(2)
    return True


def load_models(path):
    models = []
    current_id = None
    buf = []
    with open(path) as fh:
        for line in fh:
            m = HDR.match(line)
            if m:
                if current_id is not None:
                    _emit(models, current_id, buf)
                current_id = m.group(1)
                buf = []
            elif current_id is not None:
                buf.append(line)
    if current_id is not None:
        _emit(models, current_id, buf)
    return models


def _emit(models, current_id, buf):
    try:
        models.append((current_id, json.loads("".join(buf))))
    except json.JSONDecodeError:
        print(f"warning: skipping truncated/invalid model block '{current_id}'", file=sys.stderr)


def fmt_money(v):
    if v == int(v):
        return str(int(v))
    return ("%.3f" % v).rstrip("0").rstrip(".")


def fmt_cost(c):
    i, o = c.get("input", 0), c.get("output", 0)
    if i == 0 and o == 0:
        return "free"
    return f"{fmt_money(i)}/{fmt_money(o)}"


def fmt_ctx(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.0f}m"
    if n >= 1000:
        return f"{n / 1000:.0f}k"
    return str(n)


def fmt_model(qid, w):
    if len(qid) <= w:
        return qid
    return "…" + qid[-(w - 1):]


def flag(b):
    return "✓" if b else "–"


def modcell(inb, outb):
    return flag(inb) + flag(outb)


def matches(rec, filters):
    _, data = rec
    prov = data.get("providerID", "")
    id_, name, family = data["id"], data.get("name", ""), data.get("family", "")
    cost = fmt_cost(data.get("cost", {}))
    hay = f"{prov} {id_} {name} {family} {cost}".lower()
    return any(a.lower() in hay for a in filters)


def select_provider(models, provider):
    """Return models of provider (exact, case-insensitive) or None if unknown."""
    target = provider.lower()
    if target not in {r[1].get("providerID", "").lower() for r in models}:
        return None
    return [r for r in models if r[1].get("providerID", "").lower() == target]


def normalize_sort(name):
    """Return the canonical sort key for name, or None when unknown."""
    return SORT_ALIASES.get(name.lower())


def sort_value(key, rec, params):
    _, d = rec
    cost = d.get("cost", {})
    if key == "provider":
        return d.get("providerID", "").lower()
    if key == "in":
        return cost.get("input", 0)
    if key == "out":
        return cost.get("output", 0)
    if key == "cost":
        return cost.get("input", 0) + cost.get("output", 0)
    if key == "ctx":
        return d.get("limit", {}).get("context", 0)
    if key == "params":
        entry = lookup_params(params, rec[0])
        return entry.get("total") if entry and entry.get("total") is not None else None
    return rec[0].lower()


def sort_models(hits, key, reverse, params=None):
    """Sort hits in place by key; ties keep model id ascending.

    Unknown values (None) always sort last, regardless of --reverse.
    """
    direction = -1 if reverse else 1

    def compare(a, b):
        va, vb = sort_value(key, a, params), sort_value(key, b, params)
        if va is None and vb is None:
            c = 0
        elif va is None:
            return 1
        elif vb is None:
            return -1
        else:
            c = 0 if va == vb else (-1 if va < vb else 1)
        if c == 0:
            return (a[0] > b[0]) - (a[0] < b[0])
        return direction * c

    hits.sort(key=functools.cmp_to_key(compare))
    return hits


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="oc-models-report",
        description=(
            "Report capabilities/pricing of opencode models matching the given "
            "substrings. The model list is cached and auto-refreshed when older "
            "than 12 hours."
        ),
    )
    p.add_argument("filters", metavar="substring", nargs="*",
                   help="case-insensitive substring matched against provider/id/name/family "
                        "and the rendered cost (e.g. 'free')")
    p.add_argument("--provider", metavar="ID",
                   help="restrict to models of this provider (exact, case-insensitive "
                        "match on providerID); unknown provider is an error")
    p.add_argument("--refresh", action="store_true",
                   help="force regeneration of the cached model list")
    p.add_argument("--file", metavar="PATH", dest="file",
                   help="parse this dump file instead of the cache (no refresh)")
    p.add_argument("--sort", metavar="KEY", default="model",
                   help="sort by: model (default; aliases id, name), provider, "
                        "in/input, out/output, cost ($, mtok, price = input+output), "
                        "ctx/context, params (param, size)")
    p.add_argument("-r", "--reverse", action="store_true",
                   help="reverse the sort order")
    p.add_argument("--params", metavar="PATH",
                   help="parameter-count JSON file (default: model-params.json next "
                        "to the script, or $OC_MODELS_REPORT_PARAMS)")
    p.add_argument("--params-missing", action="store_true",
                   help="list models that have no parameter entry and exit")
    args = p.parse_args(argv)
    if not args.filters and not args.provider and not args.params_missing:
        p.error("specify at least one substring or --provider")
    key = normalize_sort(args.sort)
    if key is None:
        p.error(f"invalid --sort key: {args.sort}")
    args.sort = key
    return args


def report_params_missing(hits, params):
    """Print the distinct keys in hits that lack a parameter entry."""
    missing = {}
    for qid, d in hits:
        if lookup_params(params, qid) is not None:
            continue
        key = params_key(qid)
        provs, _ = missing.setdefault(key, (set(), qid))
        provs.add(d.get("providerID", ""))
    if not missing:
        print("no missing parameter entries")
        return 0
    for key in sorted(missing):
        provs, example = missing[key]
        print(f"{key}\t{','.join(sorted(provs))}\t{example}")
    print(f"\n{len(missing)} missing key(s)")
    return 0


def main(argv):
    args = parse_args(argv)

    path = args.file
    regenerated = False
    if path is None:
        path = os.path.join(cache_dir(), CACHE_FILE)
        regenerated = ensure_dump(path, args.refresh, max_age())

    if not os.path.isfile(path):
        print(f"dump not found: {path}", file=sys.stderr)
        return 2

    models = load_models(path)
    if regenerated:
        print(f"collected info of {len(models)} models\n")

    params = load_params(resolve_params_path(args.params))

    if args.provider:
        scoped = select_provider(models, args.provider)
        if scoped is None:
            print(f"error: unknown provider: {args.provider}", file=sys.stderr)
            return 2
        models = scoped

    hits = [r for r in models if not args.filters or matches(r, args.filters)]

    if args.params_missing:
        return report_params_missing(hits, params)

    sort_models(hits, args.sort, args.reverse, params)

    if args.provider:
        scope = f"provider {args.provider}"
        desc = f"{' '.join(args.filters)} ({scope})" if args.filters else scope
    else:
        desc = " ".join(args.filters)

    if not hits:
        print(f"no models match: {desc}", file=sys.stderr)
        return 1

    cost_w = 11
    ctx_w = 6
    param_w = 12
    flagcols = [("REA", 3), ("TOOL", 4), ("TMP", 3), ("ATT", 3)]
    modcols = [("TXT", 3), ("IMG", 4), ("AUD", 4), ("VID", 4), ("PDF", 4)]
    term = shutil.get_terminal_size(fallback=(100, 24)).columns
    flag_w = sum(w for _, w in flagcols) + len(flagcols) - 1
    mod_w = sum(w for _, w in modcols) + len(modcols) - 1
    overhead = 1 + cost_w + 1 + ctx_w + 1 + param_w + 1 + flag_w + 2 + mod_w
    W = max(8, term - overhead - 1)
    hdr = (
        f"{'MODEL':<{W}} {'$/MTok':<{cost_w}} {'CTX':<{ctx_w}} {'PARAM':<{param_w}} "
        + " ".join(f"{name:<{w}}" for name, w in flagcols)
        + "  "
        + " ".join(f"{name:<{w}}" for name, w in modcols)
    )
    print(hdr)
    print("-" * len(hdr))
    for qid, d in hits:
        caps = d.get("capabilities", {})
        inn = caps.get("input", {})
        out = caps.get("output", {})
        flagvals = [
            flag(caps.get("reasoning")),
            flag(caps.get("toolcall")),
            flag(caps.get("temperature")),
            flag(caps.get("attachment")),
        ]
        modvals = [
            modcell(inn.get("text"), out.get("text")),
            modcell(inn.get("image"), out.get("image")),
            modcell(inn.get("audio"), out.get("audio")),
            modcell(inn.get("video"), out.get("video")),
            modcell(inn.get("pdf"), out.get("pdf")),
        ]
        line = (
            f"{fmt_model(qid, W):<{W}} {fmt_cost(d.get('cost', {})):<{cost_w}} "
            f"{fmt_ctx(d.get('limit', {}).get('context', 0)):<{ctx_w}} "
            f"{fmt_params(lookup_params(params, qid)):<{param_w}} "
            + " ".join(f"{v:<{w}}" for v, (_, w) in zip(flagvals, flagcols))
            + "  "
            + " ".join(f"{v:<{w}}" for v, (_, w) in zip(modvals, modcols))
        )
        print(line)
    print(f"\n{len(hits)} match(es) for: {desc}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
