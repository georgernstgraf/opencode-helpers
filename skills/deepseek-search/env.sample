# DeepSeek search skill — environment overlay
#
# Copy the block for your host into the host's opencode.json under
# mcp.servers.deepseek.environment (or export it in your shell profile).
# NEVER commit a real key to this repository.
#
# Providers are walked in order; the first one that answers wins:
#   deepseek  — DeepSeek Search API, needs a key
#   searxng   — the sibling searxng skill's engine chain (SEARXNG_* contract)
#
# Without DEEPSEEK_SEARCH_API_KEY/_FILE the deepseek provider does not exist:
# the chain collapses to searxng and the envelope reports
# providers_unavailable: ["deepseek"]. That is the intended school-host state.

# --- Private setup: DeepSeek primary, SearXNG as fallback -------------------
# DEEPSEEK_SEARCH_PROVIDERS="deepseek,searxng"
# DEEPSEEK_SEARCH_API_KEY_FILE="${HOME}/.config/opencode/deepseek.key"
# (optional) DEEPSEEK_SEARCH_API_BASE="https://api.deepseek.com"
# (optional) DEEPSEEK_SEARCH_TIMEOUT="25"
#
# SEARXNG_PRIMARY="https://searxng.example.org"
# SEARXNG_PRIMARY_CRED_FILE="${HOME}/.config/opencode/searxng.cred"
# SEARXNG_CHAIN="default"

# --- School setup: no DeepSeek, SearXNG only (structural, not accidental) ---
# DEEPSEEK_SEARCH_PROVIDERS="searxng"
# SEARXNG_PRIMARY="http://searxng.internal.example"
# SEARXNG_PRIMARY_AUTH=""
# SEARXNG_CHAIN="strict"
