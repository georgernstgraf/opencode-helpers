{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "write": true,
    "bash": true
  },
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      }
    },
    "llama-cpp": {
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "gemma-4-26b": {
          "name": "Gemma 4 26B MoE (local llama-cpp)"
        }
      }
    },
    "ollama": {
      "npm": "ollama-ai-provider-v2",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/api"
      },
      "models": {
        "qwen3:30b": {
          "name": "Qwen3 30B MoE (local)"
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B MoE (local)"
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "**": "allow"
    },
    "external_directory": {
      "/tmp/**": "allow"
    },
    "searxng_searxng_search": "allow"
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": [
        "python3",
        "/home/georg/bin/opencode-searxng"
      ],
      "environment": {
        "SEARX_URL": "https://claw.graf.priv.at/search",
        "SEARX_TOKEN": "{file:~/.config/opencode/secrets/searxng.key}"
      }
    }
  }
}
